{
    "extends": "@tsconfig/node-lts/tsconfig.json",
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "paths": {
            "@backend/*": ["../backend/src/*"]
        }
    },
    "include": ["src/**/*"]
}
