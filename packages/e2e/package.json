{
    "name": "@polyratings/e2e",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "e2e": "playwright test",
        "e2e:beta": "PLAYWRIGHT_BASE_URL=https://beta.polyratings.pages.dev playwright test",
        "e2e:prod": "PLAYWRIGHT_BASE_URL=https://polyratings.dev PLAYWRIGHT_EXCLUDE_WRITE=true playwright test",
        "e2e:dev": "playwright test",
        "e2e:ui": "playwright test --ui",
        "e2e:headed": "playwright test --headed",
        "e2e:install": "playwright install chromium",
        "e2e:visual": "PLAYWRIGHT_VISUAL=compare playwright test --grep @visual",
        "e2e:visual:update": "PLAYWRIGHT_VISUAL=update playwright test --grep @visual --update-snapshots"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "^1.64.1",
        "axe-core": "^4.14.0"
    }
}
