{
    "extends": "@tsconfig/node-lts/tsconfig.json",
    "compilerOptions": {
        "lib": ["es2024", "DOM", "DOM.Iterable"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["vite/client"],
        "jsx": "react-jsx",
        "isolatedModules": true,
        "noEmit": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@/*": ["./src/*"],
            "@backend/*": ["../backend/src/*"]
        }
    },
    "include": ["./src", "./vitest-setup.ts", "./vite.config.mts"]
}
