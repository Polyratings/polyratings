{
    "extends": "@tsconfig/node-lts/tsconfig.json",
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["@cloudflare/workers-types"],
        "strictPropertyInitialization": false,
        "paths": {
            "@backend/*": ["../backend/src/*"]
        },
        "declaration": true,
        "noEmit": true,
        "noEmitHelpers": true
    },
    "include": ["src/**/*"]
}
