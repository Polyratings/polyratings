        "@cloudflare/workers-types": "^5.20261011.1",
        "@tsconfig/node-lts": "^24.0.1",
        "@types/node-fetch": "^2.6.13",
        "dotenv": "^17.4.2",
        "esbuild": "^0.28.2",
        "node-fetch": "^3.3.2",
        "typescript": "~6.0.3",
        "wrangler": "^4.149.0"
    }
}
